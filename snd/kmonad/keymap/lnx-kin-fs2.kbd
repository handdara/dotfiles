;; (deflayer blank
;;   _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
;;   _    _    _    _    _    _    _    _    _    _    _    _    _    _
;;   _    _    _    _    _    _    _    _    _    _    _    _    _    _
;;   _    _    _    _    _    _    _    _    _    _    _    _    _ 
;;   _    _    _    _    _    _    _    _    _    _    _    _    _
;;   _    _    _              _              _    _    _    _    _
;; )

(defcfg
  ;; For Linux

  ;; The first following can be used for handdara-ubuntu's default keyboard
  ;; The second following can be used to choose if multiple keyboards are available
  ;; input  (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  input  (device-file "$KBD_DEV")

  output (uinput-sink "handdara keyboard sink")

  cmp-seq ralt 
  cmp-seq-delay 5

  ;; Comment this if you want unhandled events not to be emitted
  fallthrough true
  
  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd true
)

(defalias
  to0 (layer-toggle l0)
  to1 (layer-toggle l1)
  ;; to2 (layer-toggle l2)
  ;; to3 (layer-toggle l3)
  ;; to4 (layer-toggle l4)
  ;; tp4 (around-next-timeout 500 (layer-toggle l4) XX)
  st1 (tap-hold-next-release 150 (around spc (pause 35)) (layer-toggle l1))
  shn (tap-hold-next 200 (around ret (pause 35)) lsft)
  foc (tap-hold-next 200 (around f (pause 35)) lctl)
  joc (tap-hold-next 200 (around j (pause 35)) lctl)
  gom (tap-hold-next 200 (around g (pause 35)) lmet)
  hom (tap-hold-next 200 (around h (pause 35)) lmet)
  doa (tap-hold-next 200 (around d (pause 35)) lalt)
  koa (tap-hold-next 200 (around k (pause 35)) lalt)
  gvc (tap-hold-next 200 (around grv (pause 35)) lctl)
  coe (tap-hold-next 200 (around esc (pause 35)) lctl)
  at S-2
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prnt del  
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft up
  lctl lmet lalt           spc            ralt rctl left down rght
)

(deflayer l0
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prnt del  
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @gvc a    s    @doa @foc @gom @hom @joc @koa l    ;    '    @shn
  @shn z    x    c    v    b    n    m    ,    .    /    @at  up
  @coe lmet lalt           @st1           ralt rctl left down rght
)

(deflayer l1
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _ 
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _    _    _
)
