;; (defsrc
;;   esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prnt del  
;;   grv       1    2    3    4    5    6    7    8    9    0    -    =    bspc
;;   tab       q    w    e    r    t    y    u    i    o    p    [    ]    \
;;   caps      a    s    d    f    g    h    j    k    l    ;    '    ret
;;   lsft      z    x    c    v    b    n    m    ,    .    /    rsft up
;;   lctl wkup lmet lalt           spc            ralt rctl left down rght
;; )

;;(deflayer layer_name
;;  _         _    _    _    _    _    _    _    _    _    _    _    _    _    _
;;  _         _    _    _    _    _    _    _    _    _    _    _    _    _
;;  _         _    _    _    _    _    _    _    _    _    _    _    _    _
;;  _         _    _    _    _    _    _    _    _    _    _    _    _ 
;;  _         _    _    _    _    _    _    _    _    _    _    _    _
;;  _    _    _    _              _              _    _    _    _    _
;;)

(defcfg
  ;; For Linux

  ;; The first following can be used for handdara-ubuntu's default keyboard
  ;; The second following can be used to choose if multiple keyboards are available
  ;; input  (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  input  (device-file "$KBD_DEV")

  output (uinput-sink "handdara keyboard sink")

  cmp-seq ralt 
  cmp-seq-delay 5

  ;; Comment this if you want unhandled events not to be emitted
  fallthrough true
  
  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd true
)

(defalias
  to0 (layer-toggle l0)
  to1 (layer-toggle l1)
  to2 (layer-toggle l2)
  to3 (layer-toggle l3)
  shn (tap-hold-next         200 (around ret (pause 35)) lsft)
  so1 (tap-hold-next-release 150 (around spc (pause 35)) (layer-toggle l1))
  bs2 (tap-hold-next-release 150 (around bspc (pause 35)) (layer-toggle l2))
  fhm (tap-hold-next-release 200 (around f   (pause 35)) lsft)
  dhm (tap-hold-next-release 200 (around d   (pause 35)) lctl)
  shm (tap-hold-next-release 150 (around s   (pause 35)) lalt)
  ahm (tap-hold-next-release 200 (around a   (pause 35)) lmet)
  jhm (tap-hold-next-release 200 (around j   (pause 35)) rsft)
  khm (tap-hold-next-release 200 (around k   (pause 35)) rctl)
  lhm (tap-hold-next-release 200 (around l   (pause 35)) ralt)
  chm (tap-hold-next-release 200 (around ;   (pause 35)) rmet)
  coe (tap-hold-next-release 200 (around esc (pause 35)) lctl)
  at S-2
)

(defsrc
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prnt del  
  grv       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps      a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft      z    x    c    v    b    n    m    ,    .    /    rsft up
  lctl wkup lmet lalt           spc            ralt rctl left down rght
)

(deflayer l0
  _         _    _    _    _    _    _    _    _    _    _    _    _    _    _
  tab       q    w    e    r    t    _    y    u    i    o    p    \    bspc
  esc       @ahm \shm @dhm \fhm g    _    h    @jhm @khm @lhm @chm '    @sh
  grv       z    x    c    v    b    _    n    m    ,    .    /    _
  _         _    @to3 @bs2 _    _    _    _    @so1 _    _    _    _
  _    _    _    _              @shn           _    _    _    _    _
)

(deflayer l1
  _         _    _    _    _    _    _    _    left up   down rght _    _    _
  !         {    S-9  S-0  }    ?    _    _    rsft rctl ralt rmet _    _
  #         ^    =    S--  $    *    _    del  bspc tab  spc  ret  _    _
  ~         <    |    -    >    /    _    _    _    _    _    _    _ 
  _         &    +    [    ]    _    _    _    XX   _    _    _    _
  _    _    _    _              _              _    _    _    _    _
)

(deflayer l2
  _         _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _         \    del  _    bspc >    _    ^    7    8    9    -    _    _
  _         _    _    _    _    <    _    $    4    5    6    +    _    _
  @to3      !    ret  _    spc  .    _    %    1    2    3    S--  _ 
  _         _    _    XX   _         _    _    _    _    _    _    _
  _    _    _    _              _                   _    _    _    _
)

(deflayer l3
  _         _    _    _    _    _    _    _    f10  f11  f12  _    _    _    _
  _         _    _    _    _    _    _    _    f7   f8   f9   _    _    _
  _         _    _    _    _    _    _    _    f4   f5   f6   _    _    _
  _         _    _    _    _    _    _    _    f1   f2   f3   _    _ 
  XX        _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    XX             _              _    _    _    _    _
)
