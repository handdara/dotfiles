[core]
	; editor = nvr --remote-wait-silent
    repositoryformatversion = 0
    filemode = true
    bare = false
    logallrefupdates = true
[remote "origin"]
    url = git@github.com:handdara/nix-vimrc.git
    fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
    remote = origin
    merge = refs/heads/main
[user]
    name = handdara
    email = git@handdara.com
[diff]
    tool = nvimdiff
