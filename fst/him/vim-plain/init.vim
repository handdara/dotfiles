let g:mapleader=' '
let g:maplocalleader=' '
set path+=**
syntax enable

set relativenumber
set number
set expandtab
set tabstop=4
set softtabstop=4
set nohlsearch
set ignorecase
set smartcase
set completeopt="menuone,noselect" 
set mouse="a"
set colorcolumn=100
set undofile
set splitright
set splitbelow
set signcolumn="yes"
set wildmenu
set laststatus=2

inoremap jk <esc>
inoremap kj <esc>
