let g:mapleader=' '
let g:maplocalleader=' '
set path+=**

set relativenumber
set number
set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4
set nohlsearch
set ignorecase
set smartcase
set completeopt="menuone,noselect" 
set mouse="a"
set colorcolumn=100
set undofile
set splitright
set splitbelow
set signcolumn="yes"
set wildmenu
set laststatus=2

let fortran_free_source=1
let fortran_more_precise=1
let fortran_do_enddo=1
filetype plugin indent on
syntax on

colorscheme zaibatsu

inoremap jk <esc>
inoremap kj <esc>
