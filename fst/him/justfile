set fallback

target := 'nrw'

tmp_dir := `mktemp -d`
nvim_cfg_dir := env_var('HOME') / '.config' / 'nvim'
nvim_share_dir := env_var('HOME') / '.local' / 'share' / 'nvim'
nvim_lazy_dir := nvim_share_dir / 'lazy'
jd := justfile_directory()
lazylock_file := nvim_cfg_dir / 'lazy-lock.json'

# list commands
default: 
    @just --list

_link ltgt:
    ln -sv {{jd}}/nvim-{{ltgt}} {{nvim_cfg_dir}}

# symlink nvim configuration
link: (_link target)

# purge nvim configuration directory
purge: unlink
    -rm -Rf {{nvim_cfg_dir}}

_sv_cfg_init:
    #!/usr/bin/env bash
    set -euxo pipefail
    if [ {{target}} = "main" ]; then
        cp {{nvim_cfg_dir}}/lua/handdara/config/init.lua {{tmp_dir}}/config_init.lua
    fi

_ld_cfg_init:
    #!/usr/bin/env bash
    set -euxo pipefail
    if [ {{target}} = "main" ]; then
        cp {{tmp_dir}}/config_init.lua {{nvim_cfg_dir}}/lua/handdara/config/init.lua
    fi

_purge_nix: _sv_cfg_init unlink
    -rm -Rf {{nvim_cfg_dir}}

# replace nix loaded config with symlink to nvim-main here
replace-nix: _purge_nix && link _ld_cfg_init # the && here runs the subsequent recipes after this one

# unlink main nvim configuration directory symlink
unlink:
    -rm -f {{nvim_cfg_dir}}

_get-lazylock ltgt:
    cp -f {{lazylock_file}} {{jd}}/nvim-{{ltgt}}

# retrieve the lazy lockfile for the nrw configuration
get-lazylock: (_get-lazylock target)

_place-lazylock ptgt:
    cp -f {{jd}}/nvim-{{ptgt}}/lazy-lock.json {{lazylock_file}}

place-lazylock: (_place-lazylock target)

clean-lazy-plugins:
    rm -rf {{nvim_lazy_dir}}

_update-lazylock utgt: (_place-lazylock utgt) clean-lazy-plugins && (_get-lazylock utgt)
    nvim
    nvim

update-lazylock: (_update-lazylock target)
